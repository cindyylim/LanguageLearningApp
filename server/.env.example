# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=

# Test Database (for seeding test data)
TESTDB_URI=

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODERATION_MODEL=omni-moderation-latest
MODERATION_SCORE_THRESHOLD=0.1

# Frontend URL (for CORS)
FRONTEND_URL=https://languagelearningapp-z0ca.onrender.com

# Redis URL (enables shared rate-limit counters across processes when set)
REDIS_URL=

# Quiz generation quotas (per authenticated user)
QUIZ_GENERATE_PER_MINUTE=5
QUIZ_GENERATE_PER_DAY=10